/*--------------------------------*- C++ -*----------------------------------*\
| Courant validation for a decomposed semiFrozen CHT restart                  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      courantValidationDict;
}

functions
{
    readCourantFields
    {
        type        readFields;
        libs        (fieldFunctionObjects);
        region      fluid;
        fields      (phi rho);
    }
    courantNumber
    {
        type        CourantNo;
        libs        (fieldFunctionObjects);
        region      fluid;
        writeToFile false;
    }
    courantMaximum
    {
        type        fieldMinMax;
        libs        (fieldFunctionObjects);
        region      fluid;
        fields      (Co);
        mode        magnitude;
        writeFields false;
    }
}
