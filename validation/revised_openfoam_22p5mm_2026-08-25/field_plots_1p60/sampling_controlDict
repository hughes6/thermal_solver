/*--------------------------------*- C++ -*----------------------------------*\
| Read-only field sampling dictionary for the reconstructed t=1.6 s checkpoint. |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     postProcess;
startFrom       latestTime;
stopAt          endTime;
endTime         1.6;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
writeFormat     ascii;
writePrecision  12;
runTimeModifiable false;

functions
{
    checkpointSlices
    {
        type                surfaces;
        libs                ("libsampling.so");
        region              fluid;
        writeControl        writeTime;
        surfaceFormat       raw;
        formatOptions
        {
            raw
            {
                precision   12;
            }
        }
        interpolationScheme cellPoint;
        fields              (U T p_rgh);

        surfaces
        (
            rackAndDellCenterX
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point  (0.2911475 0 0);
                    normal (1 0 0);
                }
                interpolate true;
            }

            niCenterX
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point  (0.22225 0 0);
                    normal (1 0 0);
                }
                interpolate true;
            }
        );
    }
}

