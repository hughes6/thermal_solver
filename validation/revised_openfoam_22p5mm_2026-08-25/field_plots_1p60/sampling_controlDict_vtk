/* Exact-connectivity VTK cutting planes for the t=1.6 s checkpoint. */
FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     postProcess;
startFrom       latestTime;
stopAt          endTime;
endTime         1.6;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
writeFormat     ascii;
runTimeModifiable false;

functions
{
    checkpointSlicesVtk
    {
        type                surfaces;
        libs                ("libsampling.so");
        region              fluid;
        writeControl        writeTime;
        surfaceFormat       vtk;
        formatOptions
        {
            vtk
            {
                format      ascii;
                legacy      true;
                precision   12;
            }
        }
        interpolationScheme cellPoint;
        fields              (U T p_rgh);

        surfaces
        (
            rackAndDellCenterX
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point  (0.2911475 0 0);
                    normal (1 0 0);
                }
                interpolate true;
            }

            niCenterX
            {
                type        cuttingPlane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point  (0.22225 0 0);
                    normal (1 0 0);
                }
                interpolate true;
            }
        );
    }
}

